{
  "expo": {
    "name": "CrownCrypto",
    "slug": "CrownCrypto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crowncrypto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.lolade-ilori.CrownCrypto"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lolade_ilori.CrownCrypto"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/InstrumentSans-Regular.ttf",
            "assets/fonts/InstrumentSans-Medium.ttf",
            "assets/fonts/InstrumentSans-SemiBold.ttf",
            "assets/fonts/InstrumentSans-Bold.ttf"
          ],
          "ios": {
            "fonts": [
              "assets/fonts/InstrumentSans-SemiBold.ttf",
              "assets/fonts/InstrumentSans-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
